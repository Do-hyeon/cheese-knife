{
  "name": "cheese-knife",
  "version": "2.13.3",
  "description": "A CHZZK toolkit",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-package.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:runtime-js": "node scripts/check-runtime-inventory.mjs",
    "generate:settings": "node scripts/settings-runtime.mjs --write",
    "check:settings-runtime": "node scripts/settings-runtime.mjs",
    "generate:main": "node scripts/main-runtime.mjs --write",
    "check:main-runtime": "node scripts/main-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:build-proof": "node scripts/check-build-proof.mjs",
    "test:e2e": "node scripts/check-installed-extension.mjs",
    "test:e2e:negative": "node scripts/check-installed-extension-negative.mjs",
    "audit:tools": "node scripts/tool-audit.mjs",
    "inspect:site": "node scripts/inspect-site.mjs",
    "postversion": "manifest=\"$(jq \".version = `jq '.version' package.json`\" manifest.json)\" && echo \"$manifest\" > manifest.json",
    "publish:chrome": "google-chrome --headless --no-sandbox --disable-crash-reporter --no-crashpad --pack-extension=./dist --pack-extension-key=key.pem && chrome-webstore-upload --source=dist.crx"
  },
  "devDependencies": {
    "@types/chrome": "0.2.8",
    "chrome-webstore-upload-cli": "4.0.0-0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.0",
    "hls.js": "1.6.16",
    "jsdom": "30.1.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  }
}
